---
/**
 * /achievements/<slug>
 *
 * One page per achievement, generated from src/data/achievements.ts.
 * University & extracurriculars live under /university/<slug> instead.
 */
import AchievementDetail from '../../components/AchievementDetail.astro';
import { DETAIL_ACHIEVEMENTS } from '../../data/achievements';

export function getStaticPaths() {
	return DETAIL_ACHIEVEMENTS.map((achievement) => ({
		params: { slug: achievement.slug },
		props: { achievement },
	}));
}

const { achievement } = Astro.props;
const siblings = DETAIL_ACHIEVEMENTS.filter((item) => item.category === achievement.category);
---

<AchievementDetail
	achievement={achievement}
	siblings={siblings}
	basePath="/achievements"
	backLabel="all achievements"
	section="achievements"
/>
