---
/**
 * /achievements/<slug>
 *
 * One page per achievement, generated from src/data/achievements.ts.
 *
 * The gallery is discovered from src/assets/achievements/<slug>/ at build
 * time, so a new screenshot needs no code change here.
 */
import Base from '../../layouts/Base.astro';
import PortfolioMenu from '../../components/PortfolioMenu.astro';
import AchievementGallery from '../../components/AchievementGallery.astro';
import { DETAIL_ACHIEVEMENTS, CATEGORY_LABELS, galleryFor } from '../../data/achievements';
import { ArrowLeft, ArrowUpRight } from 'lucide-astro';

export function getStaticPaths() {
	return DETAIL_ACHIEVEMENTS.map((achievement) => ({
		params: { slug: achievement.slug },
		props: { achievement },
	}));
}

const { achievement } = Astro.props;
const images = galleryFor(achievement.slug, achievement.captions);

// Previous / next within the same category, wrapping around.
const siblings = DETAIL_ACHIEVEMENTS.filter((item) => item.category === achievement.category);
const position = siblings.findIndex((item) => item.slug === achievement.slug);
const previous = siblings[(position - 1 + siblings.length) % siblings.length];
const next = siblings[(position + 1) % siblings.length];
const showSiblings = siblings.length > 1;
---

<Base
	title={`anga / achievements / ${achievement.slug}`}
	description={`${achievement.title} — ${achievement.result}. ${achievement.summary}`}
>
	<PortfolioMenu initiallyVisible minimized />

	<main class="page">
		<div class="window">
			<div class="headerbar">
				<span class="dots" aria-hidden="true">
					<span></span><span></span><span></span>
				</span>
				<span class="title">anga@portfolio — achievements/{achievement.slug}</span>
				<span aria-hidden="true"></span>
			</div>

			<div class="body">
				<nav class="crumbs" aria-label="Breadcrumb">
					<a href="/achievements">achievements</a>
					<span aria-hidden="true">/</span>
					<span aria-current="page">{achievement.slug}</span>
				</nav>

				<p class="prompt">$ cat achievements/{achievement.slug}.md</p>

				<header class="head">
					<h1>{achievement.title}</h1>
					<p class="summary">{achievement.summary}</p>

					<div class="meta">
						<span class="result">{achievement.result}</span>
						<span class="meta-item">{achievement.date}</span>
						<span class="meta-item">{CATEGORY_LABELS[achievement.category]}</span>
					</div>
				</header>

				<section class="prose" aria-label="Overview">
					{achievement.detail.overview.map((paragraph) => <p>{paragraph}</p>)}
				</section>

				<section class="block" aria-labelledby="highlights">
					<h2 id="highlights">highlights</h2>
					<ul class="highlights">
						{achievement.detail.highlights.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</section>

				{
					achievement.detail.stack && achievement.detail.stack.length > 0 && (
						<section class="block" aria-labelledby="stack">
							<h2 id="stack">stack</h2>
							<ul class="stack">
								{achievement.detail.stack.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</section>
					)
				}

				<section class="block" aria-labelledby="tags">
					<h2 id="tags">tags</h2>
					<ul class="stack">
						{achievement.tags.map((tag) => (
							<li>{tag}</li>
						))}
					</ul>
				</section>

				{
					images.length > 0 && (
						<section class="block" aria-labelledby="gallery">
							<h2 id="gallery">
								gallery
								<span class="count">{String(images.length).padStart(2, '0')}</span>
							</h2>
							<AchievementGallery images={images} title={achievement.title} />
						</section>
					)
				}

				{
					achievement.links && achievement.links.length > 0 && (
						<section class="block" aria-labelledby="links">
							<h2 id="links">links</h2>
							<div class="actions">
								{achievement.links.map((link) => (
									<a class="action" href={link.href} target="_blank" rel="noreferrer">
										{link.label}
										<ArrowUpRight size={12} strokeWidth={1.5} aria-hidden="true" />
									</a>
								))}
							</div>
						</section>
					)
				}

				<footer class="foot">
					<a class="back" href="/achievements">
						<ArrowLeft size={13} strokeWidth={1.5} aria-hidden="true" />
						all achievements
					</a>

					{
						showSiblings && (
							<div class="siblings">
								<a class="sibling" href={`/achievements/${previous.slug}`}>
									<span class="sibling-label">prev</span>
									<span class="sibling-title">{previous.title}</span>
								</a>
								<a class="sibling" href={`/achievements/${next.slug}`}>
									<span class="sibling-label">next</span>
									<span class="sibling-title">{next.title}</span>
								</a>
							</div>
						)
					}
				</footer>
			</div>
		</div>
	</main>
</Base>

<style>
	.page {
		margin-left: 18rem;
		height: 100vh;
		overflow-y: auto;
		padding: 2rem;
		background: #171717;
	}

	.window {
		max-width: 60rem;
		margin: 0 auto;
		overflow: hidden;
		border: 1px solid #3d3846;
		border-radius: 6px;
		background: #000000;
		box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
	}

	.headerbar {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 0.75rem;
		border-bottom: 1px solid #3d3846;
		background: #303030;
		color: #deddda;
		font-size: 0.75rem;
		letter-spacing: 0.02em;
		user-select: none;
	}

	.dots {
		display: flex;
		gap: 0.375rem;
	}

	.dots span {
		width: 0.625rem;
		height: 0.625rem;
		border-radius: 999px;
	}

	.dots span:nth-child(1) {
		background: #e01b24;
	}

	.dots span:nth-child(2) {
		background: #e5a50a;
	}

	.dots span:nth-child(3) {
		background: #33d17a;
	}

	.title {
		text-align: center;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.body {
		padding: 1.75rem;
		color: #ffffff;
		font-size: 0.875rem;
		line-height: 1.75;
	}

	.crumbs {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		margin-bottom: 1rem;
		color: #737373;
		font-size: 0.6875rem;
	}

	.crumbs a {
		color: #737373;
		text-decoration: none;
	}

	.crumbs a:hover {
		color: #26a269;
	}

	.crumbs a:focus-visible {
		outline: 1px solid #26a269;
		outline-offset: 2px;
	}

	.prompt {
		margin: 0 0 1.25rem;
		color: #26a269;
		font-size: 0.75rem;
	}

	.head {
		margin-bottom: 1.75rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid #262626;
	}

	.head h1 {
		margin: 0 0 0.4rem;
		font-size: 1.35rem;
		font-weight: 400;
	}

	.summary {
		margin: 0 0 0.9rem;
		max-width: 58ch;
		color: #a5a3a9;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.6875rem;
	}

	.result {
		padding: 0.05rem 0.35rem;
		border: 1px solid #2f5c3f;
		border-radius: 3px;
		background: rgba(38, 162, 105, 0.1);
		color: #26a269;
	}

	.meta-item {
		color: #737373;
	}

	.prose p {
		margin: 0 0 1.1rem;
		max-width: 68ch;
		color: #a5a3a9;
	}

	.block {
		margin-top: 1.75rem;
	}

	.block h2 {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		margin: 0 0 0.75rem;
		color: #26a269;
		font-size: 0.75rem;
		font-weight: 400;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.count {
		color: #4a4a4a;
		font-size: 0.6875rem;
	}

	.highlights {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.highlights li {
		position: relative;
		margin-bottom: 0.4rem;
		padding-left: 1.1rem;
		max-width: 68ch;
		color: #a5a3a9;
	}

	.highlights li::before {
		content: '-';
		position: absolute;
		left: 0;
		color: #26a269;
	}

	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.stack li {
		padding: 0.05rem 0.35rem;
		border: 1px solid #3d3846;
		border-radius: 3px;
		color: #a5a3a9;
		font-size: 0.6875rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.action {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.25rem 0.55rem;
		border: 1px solid #3d3846;
		border-radius: 3px;
		color: #deddda;
		font-size: 0.75rem;
		text-decoration: none;
	}

	.action:hover {
		border-color: #5a5560;
		background: #262626;
		color: #ffffff;
	}

	.action:focus-visible {
		outline: 1px solid #26a269;
		outline-offset: 2px;
	}

	.foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 2.25rem;
		padding-top: 1.5rem;
		border-top: 1px solid #262626;
	}

	.back {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: #a5a3a9;
		font-size: 0.75rem;
		text-decoration: none;
	}

	.back:hover {
		color: #26a269;
	}

	.back:focus-visible {
		outline: 1px solid #26a269;
		outline-offset: 2px;
	}

	.siblings {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.sibling {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		padding: 0.35rem 0.6rem;
		border: 1px solid #3d3846;
		border-radius: 4px;
		text-decoration: none;
	}

	.sibling:hover {
		border-color: #5a5560;
		background: #1c1c1c;
	}

	.sibling:focus-visible {
		outline: 1px solid #26a269;
		outline-offset: 2px;
	}

	.sibling-label {
		color: #737373;
		font-size: 0.625rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.sibling-title {
		color: #deddda;
		font-size: 0.75rem;
	}

	@media (max-width: 639px) {
		.page {
			margin-left: 0;
			padding: 1rem 1rem 6rem;
		}

		.body {
			padding: 1.25rem;
		}

		.foot {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
