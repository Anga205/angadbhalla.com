---
import Base from '../layouts/Base.astro';
import PortfolioMenu from '../components/PortfolioMenu.astro';
import Pager from '../components/Pager.astro';
import AchievementCards from '../components/AchievementCards.astro';
import { ACHIEVEMENT_INDEX, hasDetailPage } from '../data/achievements';
import { collectionPageSchema, type JsonLd } from '../lib/seo';

const description =
	'Hackathon results, contest milestones, research, community work, and open source contributions by Angad Bhalla.';

const schema: JsonLd[] = [
	collectionPageSchema({
		path: '/achievements',
		name: 'Achievements',
		description,
		items: ACHIEVEMENT_INDEX.map((achievement) => ({
			name: achievement.title,
			path: hasDetailPage(achievement)
				? `/achievements/${achievement.slug}`
				: '/achievements',
		})),
	}),
];
---

<Base title="Angad Bhalla — Achievements" {description} path="/achievements" {schema}>
	<PortfolioMenu minimized />
	<Pager active="achievements">
		<AchievementCards />
	</Pager>
</Base>
