---
import Base from '../layouts/Base.astro';
import PortfolioMenu from '../components/PortfolioMenu.astro';
---

<Base title="anga / achievements" description="Certificates, hackathons, and contributions.">
	<PortfolioMenu initiallyVisible minimized />
	<main class="page">
		<p class="prompt">$ cat achievements.txt</p>
		<h1>achievements</h1>
		<p>This section is being written.</p>
	</main>
</Base>

<style>
	.page {
		margin-left: 18rem;
		padding: 3rem 2rem;
		max-width: 60ch;
	}

	.prompt {
		margin: 0 0 0.75rem;
		color: #26a269;
		font-size: 0.75rem;
	}

	.page h1 {
		margin: 0 0 0.75rem;
		color: #ffffff;
		font-size: 1.25rem;
		font-weight: 400;
	}

	.page p {
		margin: 0;
		color: #a5a3a9;
		line-height: 1.75;
	}

	@media (max-width: 639px) {
		.page {
			margin-left: 0;
			padding-bottom: 6rem;
		}
	}
</style>
