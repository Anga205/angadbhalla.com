---
import Base from '../layouts/Base.astro';
import PortfolioMenu from '../components/PortfolioMenu.astro';
import { Mail, Github, Linkedin, Instagram, MessageCircle, Send, ArrowUpRight } from 'lucide-astro';

const contacts = [
	{
		label: 'email',
		value: 'angadbhalla2005@gmail.com',
		href: 'mailto:angadbhalla2005@gmail.com',
		icon: Mail,
	},
	{
		label: 'github',
		value: 'github.com/Anga205',
		href: 'https://github.com/Anga205/',
		icon: Github,
	},
	{
		label: 'linkedin',
		value: 'linkedin.com/in/anga',
		href: 'https://www.linkedin.com/in/anga',
		icon: Linkedin,
	},
	{
		label: 'discord',
		value: '@anga205',
		href: 'https://discord.com/users/477680545271250944',
		icon: MessageCircle,
	},
	{
		label: 'instagram',
		value: '@_anga205',
		href: 'https://www.instagram.com/_anga205/',
		icon: Instagram,
	},
] as const;
---

<Base title="anga / contact" description="GitHub, LinkedIn, email, and other ways to contact Angad Bhalla.">
	<PortfolioMenu minimized />

	<main class="page ml-72 h-screen overflow-y-auto bg-[#171717] p-8 max-[639px]:ml-0 max-[639px]:px-4 max-[639px]:pt-4 max-[639px]:pb-24">
		<div class="window mx-auto max-w-184 overflow-hidden rounded-md border border-[#3d3846] bg-[#000000] shadow-[0_25px_50px_-12px_rgba(0,0,0,0.25)]">
			<div class="headerbar grid grid-cols-[1fr_auto_1fr] items-center gap-2 border-b border-[#3d3846] bg-[#303030] px-3 py-2 text-[0.75rem] tracking-[0.02em] text-[#deddda] select-none">
				<span class="dots flex gap-1.5" aria-hidden="true"><span class="size-2.5 rounded-full bg-[#e01b24]"></span><span class="size-2.5 rounded-full bg-[#e5a50a]"></span><span class="size-2.5 rounded-full bg-[#33d17a]"></span></span>
				<span class="title text-center whitespace-nowrap">anga@portfolio — contact</span>
				<span aria-hidden="true"></span>
			</div>

			<div class="body p-7 text-[0.875rem] leading-[1.75] text-white max-[639px]:p-5">
				<p class="prompt mb-3 text-[0.75rem] text-[#26a269]">$ cat contact.txt</p>
				<h1 class="mb-2 text-[1.35rem] font-normal">contact</h1>
				<p class="lede mb-6 max-w-[52ch] text-[#a5a3a9]">The fastest way to reach me is email. Everything else is here too.</p>

				<ul class="contacts m-0 mb-8 list-none border-t border-line p-0">
					{contacts.map((contact) => {
						const Icon = contact.icon;
						const external = contact.href.startsWith('http');
						return (
							<li class="contact flex items-center gap-2 border-b border-line">
								<a class="contact-link -ml-2 grid min-w-0 flex-1 grid-cols-[1.5rem_minmax(0,1fr)_1rem] items-center gap-x-3 rounded-[3px] px-2 py-[0.6rem] text-inherit no-underline hover:bg-[#1c1c1c] focus-visible:outline focus-visible:outline-[#26a269] focus-visible:outline-offset-2" href={contact.href} target={external ? '_blank' : undefined} rel={external ? 'noreferrer' : undefined}>
									<span class="contact-icon flex items-center justify-center text-dim" aria-hidden="true"><Icon size={16} strokeWidth={1.5} /></span>
									<span class="contact-text flex min-w-0 flex-wrap items-baseline gap-3 max-[639px]:flex-col max-[639px]:gap-[0.1rem]">
										<span class="contact-label min-w-22 text-white max-[639px]:min-w-0">{contact.label}</span>
										<span class="contact-value wrap-anywhere text-[#a5a3a9]">{contact.value}</span>
									</span>
									<ArrowUpRight size={14} strokeWidth={1.5} class="contact-arrow text-transparent" aria-hidden="true" />
								</a>
							</li>
						);
					})}
				</ul>

				<section class="form-section border-t border-line pt-6" aria-labelledby="form-heading">
					<h2 class="mb-1 text-[0.9375rem] font-normal" id="form-heading">send a message</h2>
					<p class="form-note mb-5 text-[0.8125rem] text-[#a5a3a9]">Or use this form. It goes straight to my inbox.</p>
					<form id="contact-form" novalidate>
						<label class="field"><span>your email</span><input type="email" name="email" id="email" autocomplete="email" required placeholder="you@example.com" /></label>
						<label class="field"><span>message</span><textarea name="message" id="message" rows="5" required placeholder="what's on your mind?"></textarea></label>
						<div class="form-actions"><button type="submit" id="send"><Send size={13} strokeWidth={1.5} aria-hidden="true" />send</button><span id="form-status" role="status"></span></div>
					</form>
				</section>
			</div>
		</div>
	</main>
</Base>

<style>
	.contact-link:hover .contact-icon, .contact-link:hover .contact-arrow { color: #26a269; }
	.field { display: block; margin-bottom: 1rem; }
	.field > span { display: block; margin-bottom: 0.35rem; color: #a5a3a9; font-size: 0.75rem; }
	.field input, .field textarea { display: block; width: 100%; padding: 0.5rem 0.6rem; border: 1px solid #3d3846; border-radius: 3px; background: #1c1c1c; color: #ffffff; font: inherit; font-size: 0.8125rem; resize: vertical; }
	.field input::placeholder, .field textarea::placeholder { color: #6b6b6b; }
	.field input:focus, .field textarea:focus { outline: 1px solid #26a269; outline-offset: 1px; border-color: #26a269; }
	.form-actions { display: flex; align-items: center; gap: 0.75rem; }
	#send { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.35rem 0.75rem; border: 1px solid #3d3846; border-radius: 3px; background: #303030; color: #deddda; font: inherit; font-size: 0.8125rem; cursor: pointer; }
	#send:hover:not(:disabled) { background: #3d3846; color: #ffffff; }
	#send:disabled { color: #6b6b6b; cursor: default; }
	#send:focus-visible { outline: 1px solid #26a269; outline-offset: 2px; }
	#form-status { color: #a5a3a9; font-size: 0.75rem; }
	#form-status.is-error { color: #ff7b72; }
	#form-status.is-ok { color: #26a269; }
</style>

<script>
	import emailjs from '@emailjs/browser';

	const SERVICE_ID = 'YOUR_SERVICE_ID';
	const TEMPLATE_ID = 'YOUR_TEMPLATE_ID';
	const PUBLIC_KEY = 'YOUR_PUBLIC_KEY';
	const form = document.getElementById('contact-form') as HTMLFormElement | null;
	const send = document.getElementById('send') as HTMLButtonElement | null;
	const status = document.getElementById('form-status');

	if (form && send && status) {
		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const data = new FormData(form);
			const email = String(data.get('email') ?? '').trim();
			const message = String(data.get('message') ?? '').trim();
			if (!email || !message) {
				status.textContent = 'email and message are required.';
				status.className = 'is-error';
				return;
			}
			send.disabled = true;
			status.textContent = 'sending...';
			status.className = '';
			try {
				await emailjs.send(SERVICE_ID, TEMPLATE_ID, { from_email: email, message }, { publicKey: PUBLIC_KEY });
				form.reset();
				status.textContent = 'sent. thanks.';
				status.className = 'is-ok';
			} catch {
				status.textContent = 'could not send. email me directly instead.';
				status.className = 'is-error';
			} finally {
				send.disabled = false;
			}
		});
	}
</script>
