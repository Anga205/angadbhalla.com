---
import Base from '../layouts/Base.astro';
import PortfolioMenu from '../components/PortfolioMenu.astro';
import Pager from '../components/Pager.astro';
import ProjectCards from '../components/ProjectCards.astro';
import { PROJECTS } from '../data/projects';
import { collectionPageSchema, softwareSourceCodeSchema, type JsonLd } from '../lib/seo';

const description =
	'Software Angad Bhalla has built: a self-hosted file host, a sandboxed code execution API, a bare-bones operating system, and more.';

const keywords = [
	'Angad Bhalla',
	'systems programming',
	'Go',
	'Rust',
	'self-hosted',
	'file hosting',
	'code execution sandbox',
	'seccomp',
	'operating system',
	'open source',
	'Bengaluru',
];

// Only AngaDriveV3 has a long-form route; the rest are name-only so the
// ItemList never advertises a fragment URL.
const schema: JsonLd[] = [
	collectionPageSchema({
		path: '/projects',
		name: 'Projects',
		description,
		items: PROJECTS.map((project) => ({
			name: project.name,
			path: project.detail,
		})),
	}),
	...PROJECTS.map((project) =>
		softwareSourceCodeSchema({
			path: `/projects#${project.id}`,
			name: project.name,
			description: project.description,
			codeRepository: project.repo,
			programmingLanguage: project.stack,
			dateCreated: project.dateCreated,
			url: project.live,
		}),
	),
];
---

<Base title="Angad Bhalla — Projects" {description} path="/projects" {keywords} {schema}>
	<PortfolioMenu minimized />
	<Pager active="projects">
		<ProjectCards intro="Systems software built from scratch: a self-hosted file host in Go, a seccomp sandbox for untrusted code, a bare-bones operating system, and a Rust competitive programming tracker." />
	</Pager>
</Base>
