---
import DesktopHome from "@/components/views/desktop/Home.astro";
import MobileHome from "@/components/views/mobile/Home.astro";

export const prerender = false;

const userAgent = Astro.request.headers.get("user-agent") ?? "";
const mobileHint = Astro.request.headers.get("sec-ch-ua-mobile");

const isMobile =
    mobileHint === "?1" ||
    /Android|iPhone|iPad|Mobile/i.test(userAgent);
---

{isMobile ? <MobileHome /> : <DesktopHome />}
