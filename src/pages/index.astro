---
import Base from '../layouts/Base.astro';
import PortfolioMenu from '../components/PortfolioMenu.astro';
---

<Base title="anga / home" description="Angad Bhalla. Computer science student in Bengaluru.">
	<PortfolioMenu minimized />

	<main class="page ml-72 h-screen overflow-y-auto bg-[#171717] p-8 max-[639px]:ml-0 max-[639px]:px-4 max-[639px]:pt-4 max-[639px]:pb-24">
		<div class="window mx-auto max-w-240 overflow-hidden rounded-md border border-[#3d3846] bg-[#000000] shadow-[0_25px_50px_-12px_rgba(0,0,0,0.25)]">
			<div class="headerbar grid grid-cols-[1fr_auto_1fr] items-center gap-2 border-b border-[#3d3846] bg-[#303030] px-3 py-2 text-[0.75rem] tracking-[0.02em] text-[#deddda] select-none">
				<span class="dots flex gap-1.5" aria-hidden="true">
					<span class="size-2.5 rounded-full bg-[#e01b24]"></span><span class="size-2.5 rounded-full bg-[#e5a50a]"></span><span class="size-2.5 rounded-full bg-[#33d17a]"></span>
				</span>
				<span class="title text-center whitespace-nowrap">anga@portfolio — home</span>
				<span aria-hidden="true"></span>
			</div>

			<div class="body p-7 text-[0.875rem] leading-[1.75] text-white max-[639px]:p-5">
				<p class="prompt mb-5 text-[0.75rem] text-[#26a269]">$ cat home.txt</p>

				<div class="intro mb-8 grid grid-cols-[minmax(0,1fr)_16rem] items-start gap-6 border-b border-line pb-8 max-[899px]:grid-cols-[minmax(0,1fr)]">
					<div class="intro-text">
						<h1 class="mb-2 text-[1.35rem] font-normal">Angad Bhalla</h1>
						<p class="mb-3 max-w-[52ch] text-[#a5a3a9]">
							I'm an undergraduate pursuing a degree in Computer Science &amp; Engineering at PES
							University, Bangalore (2023-2027), with experience across systems engineering,
							infrastructure, and cybersecurity.
						</p>
						<p class="mb-3 max-w-[52ch] text-[#a5a3a9]">
							I've completed internships at Goldman Sachs, Frigga Cloud, and Araciv Technologies,
							working across infrastructure, security, and software development.
						</p>
						<p class="mb-3 max-w-[52ch] text-[#a5a3a9]">
							At PES University, I led Team Alcoding, the competitive programming club,
							organizing hackathons and coding contests. I also conducted the competitive
							programming course at PESU I/O (Slot 20).
						</p>
						<p class="mb-0 max-w-[52ch] text-[#a5a3a9]">
							Outside of work, I spend time learning the craft of coffee, exploring brewing
							techniques and refining my understanding of the process. I also volunteer in
							community initiatives, including fundraising for stray dogs.
						</p>
					</div>

					{/* Portrait photo, fully rounded. */}
					<div class="portrait-photo">
						<img
							src="/angad.png"
							alt="Angad Bhalla"
							width="512"
							height="512"
							loading="eager"
							decoding="async"
						/>
					</div>
				</div>

				<section class="philosophy">
					<div class="philosophy-grid">
						<div class="philosophy-text">
							<h3 class="text-[1.05rem] font-normal">My Philosophy</h3>
							<h2 class="mb-3 text-[0.75rem] font-normal tracking-[0.04em] text-[#26a269] uppercase">On building things</h2>

							<p class="mb-[1.1rem] text-[#a5a3a9]">
								I think the best engineers treat software the same way a craftsman treats his work.
								Every project is another chance to create something beautiful, the only way to learn
								is to make mistakes. And every problem has a dozen different ways to be approached,
								and sometimes, to get something wrong feels just as good as getting something right,
								in fact, sometimes I try to get it as wrong as humanly possible, theres fun in seeing
								a chaos.
							</p>

							<p class="mb-[1.1rem] text-[#a5a3a9]">
								One of the best things that can happen to you in this field is to find someone who
								loves and respects the craft as much as you do. Talent and skill is obviously a great
								thing, but to admire the field, even in its goofyness, is a rare and wonderful
								feeling. The most fun projects tend to start off with a "I know this sounds weird but
								what if-" and the best projects are ones where you dont know what final product you're
								aiming for, after all, the journey is just as fun as the destination.
							</p>

							<p class="mb-[1.1rem] text-[#a5a3a9]">The goofier the project, the better.</p>

							<p class="mb-[1.1rem] text-[#a5a3a9]">
								This field puts you into predicaments that perhaps nobody in the history of mankind
								has ever dealt with before, there are no right answers, but there are fun approaches,
								and who knows? maybe someday I myself will get to set the standard for what is right
								and what is wrong, but until then, I will continue to make mistakes, and learn from
								them.
							</p>

							<p class="mb-[1.1rem] text-[#a5a3a9]">
								That's why I'm incredibly proud of every major project I've built. I could probably
								spend hours or days talking about why AngaDrive is efficient down to the last CPU
								clock cycle, or why I designed my Online Compiler the way I did. After all, every
								optimization, every redesign, and every mistake has a story behind it.
							</p>

							<p class="pull italic font-sans">
								A project to an engineer is what jewelry is to a goldsmith. Anyone can appriciate the
								beauty of the craft, but only the maker can truly admire the process by which it was
								forged.
							</p>
						</div>

						{/* Reserved for the full-body GLB. The viewer mounts here. */}
						<div class="portrait" id="portrait" data-model="/anga.glb">
							<div class="portrait-canvas" id="portrait-canvas"></div>
							<p class="portrait-fallback" id="portrait-fallback">loading model…</p>
						</div>
					</div>
				</section>
			</div>
		</div>
	</main>
</Base>

<style>
	.portrait-photo {
		display: grid;
		place-items: center;
	}

	.portrait-photo img {
		display: block;
		width: 100%;
		max-width: 16rem;
		aspect-ratio: 1;
		border-radius: 9999px;
		border: 1px solid #3d3846;
		object-fit: cover;
	}

	.philosophy-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 16rem;
		align-items: start;
		gap: 1.5rem;
	}

	.portrait {
		position: relative;
		height: 30rem;
		overflow: hidden;
	}

	.portrait-canvas {
		position: absolute;
		inset: 0;
		cursor: grab;
		touch-action: none;
	}

	.portrait-canvas:active {
		cursor: grabbing;
	}

	/* The canvas is created at runtime, so it never receives Astro's scope
	   attribute. Keep this rule global so the drawing buffer is scaled down
	   to the CSS box instead of overflowing it. */
	.portrait-canvas :global(canvas) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.portrait-fallback {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		margin: 0;
		color: #737373;
		font-size: 0.75rem;
	}

	.portrait.is-ready .portrait-fallback {
		display: none;
	}

	.philosophy .pull {
		margin: 1.5rem 0;
		padding-left: 0.9rem;
		border-left: 2px solid #26a269;
		color: #ffffff;
	}

	@media (max-width: 899px) {
		.philosophy-grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.portrait {
			height: 18rem;
		}
	}

</style>

<script>
	// The model is loaded only when the portrait scrolls into view, so the
	// about page stays cheap until someone actually looks at it.
	const portrait = document.getElementById('portrait');
	const host = document.getElementById('portrait-canvas');

	if (portrait && host) {
		const portraitElement = portrait;
		const hostElement = host;
		const modelUrl = portraitElement.dataset.model ?? '/anga.glb';

		const observer = new IntersectionObserver(
			(entries) => {
				if (!entries.some((entry) => entry.isIntersecting)) return;
				observer.disconnect();
				load().catch(() => {
					// Keep the fallback text if the model cannot be loaded.
				});
			},
			{ rootMargin: '200px' },
		);

		async function load() {
			const THREE = await import('three');
			const { GLTFLoader } = await import('three/examples/jsm/loaders/GLTFLoader.js');
			const { OrbitControls } = await import('three/examples/jsm/controls/OrbitControls.js');
			const { MeshoptDecoder } = await import(
				'three/examples/jsm/libs/meshopt_decoder.module.js'
			);

			const scene = new THREE.Scene();
			const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 100);
			const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });

			renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
			renderer.setClearColor(0x000000, 0);
			hostElement.append(renderer.domElement);

			const controls = new OrbitControls(camera, renderer.domElement);
			controls.enableDamping = true;
			controls.dampingFactor = 0.16;
			const baseRotateSpeed = 0.6;
			controls.rotateSpeed = baseRotateSpeed;
			controls.enablePan = false;
			controls.enableZoom = false;

			scene.add(new THREE.HemisphereLight(0xffffff, 0x444444, 2.2));
			const key = new THREE.DirectionalLight(0xffffff, 2);
			key.position.set(2, 4, 3);
			scene.add(key);

			// The model is compressed with EXT_meshopt_compression, so the
			// decoder has to be registered before parsing.
			const loader = new GLTFLoader();
			loader.setMeshoptDecoder(MeshoptDecoder);

			const gltf = await loader.loadAsync(modelUrl);
			const model = gltf.scene;

			// Ground the model: horizontally centred on the origin, lowest
			// point resting on Y = 0. The authored scale is left untouched.
			const box = new THREE.Box3().setFromObject(model);
			const size = box.getSize(new THREE.Vector3());
			const center = box.getCenter(new THREE.Vector3());
			model.position.x -= center.x;
			model.position.z -= center.z;
			model.position.y -= box.min.y;

			scene.add(model);

			// Fixed camera: diagonally towards the model's centre from its
			// positive-X, negative-Z side.
			const target = new THREE.Vector3(0, size.y / 2, 0);
			camera.position.set(1.1, 0.95, -0.60);
			controls.target.copy(target);

			const offset = camera.position.clone().sub(target);
			const initialAzimuth = Math.atan2(offset.x, offset.z);
			const initialPolar = Math.acos(offset.y / offset.length());
			const initialPosition = camera.position.clone();
			controls.minPolarAngle = initialPolar;
			controls.maxPolarAngle = initialPolar;
			const horizontalLimit = THREE.MathUtils.degToRad(82);
			controls.minAzimuthAngle = initialAzimuth - horizontalLimit;
			controls.maxAzimuthAngle = initialAzimuth + horizontalLimit;
			const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			const resetResistance = () => {
				controls.rotateSpeed = baseRotateSpeed;
			};

			const applyResistance = () => {
				const distance = Math.abs(controls.getAzimuthalAngle() - initialAzimuth);
				const progress = Math.min(distance / horizontalLimit, 1);
				controls.rotateSpeed = baseRotateSpeed * Math.exp(-8 * progress * progress);
			};

			renderer.domElement.addEventListener('pointerdown', resetResistance, { capture: true });
			renderer.domElement.addEventListener('pointermove', applyResistance, { capture: true });
			renderer.domElement.addEventListener('pointerup', resetResistance, { capture: true });
			renderer.domElement.addEventListener('pointercancel', resetResistance, { capture: true });

			controls.update();
			controls.saveState();

			let snapFrame = 0;
			let snapTimeout = 0;

			const cancelSnap = () => {
				window.clearTimeout(snapTimeout);
				window.cancelAnimationFrame(snapFrame);
				snapFrame = 0;
			};

			const snapBack = () => {
				const snapStart = camera.position.clone();
				const startOffset = snapStart.sub(target);
				const startAzimuth = Math.atan2(startOffset.x, startOffset.z);
				let azimuthDelta = initialAzimuth - startAzimuth;
				if (azimuthDelta > Math.PI) azimuthDelta -= Math.PI * 2;
				if (azimuthDelta < -Math.PI) azimuthDelta += Math.PI * 2;

				const horizontalRadius = Math.hypot(startOffset.x, startOffset.z);
				const verticalOffset = initialPosition.y - target.y;
				const startedAt = performance.now();
				const duration = reduced ? 0 : 420;
				controls.enableDamping = false;

				const frame = (now: number) => {
					const progress = Math.min((now - startedAt) / duration, 1);
					const eased = 1 - Math.pow(1 - progress, 3);
					const azimuth = startAzimuth + azimuthDelta * eased;
					camera.position.set(
						target.x + Math.sin(azimuth) * horizontalRadius,
						target.y + verticalOffset,
						target.z + Math.cos(azimuth) * horizontalRadius,
					);
					controls.update();
					renderer.render(scene, camera);

					if (progress < 1) {
						snapFrame = window.requestAnimationFrame(frame);
						return;
					}

					camera.position.copy(initialPosition);
					controls.update();
					controls.enableDamping = !reduced;
					snapFrame = 0;
				};

				snapFrame = window.requestAnimationFrame(frame);
			};

			controls.addEventListener('start', cancelSnap);
			controls.addEventListener('end', () => {
				window.clearTimeout(snapTimeout);
				snapTimeout = window.setTimeout(snapBack, 140);
			});

			function resize() {
				const width = hostElement.clientWidth;
				const heightPx = hostElement.clientHeight;
				if (!width || !heightPx) return;
				renderer.setSize(width, heightPx);
				camera.aspect = width / heightPx;
				camera.updateProjectionMatrix();
				renderer.render(scene, camera);
			}

			resize();
			new ResizeObserver(resize).observe(hostElement);

			// Only reveal the canvas once it has been sized and drawn, so the
			// first visible frame is already correctly framed.
			portraitElement.classList.add('is-ready');

			if (reduced) {
				// No inertia: redraw only when the user actually moves the camera.
				controls.enableDamping = false;
				controls.addEventListener('change', () => renderer.render(scene, camera));
				renderer.render(scene, camera);
			} else {
				function frame() {
					controls.update();
					renderer.render(scene, camera);
					requestAnimationFrame(frame);
				}

				frame();
			}
		}

		observer.observe(portraitElement);
	}
</script>
