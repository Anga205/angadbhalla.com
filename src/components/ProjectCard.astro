---
/**
 * ProjectCard.astro
 *
 * One project tile. Extracted from the inline `.map()` body in
 * ProjectCards.astro.
 *
 * Cards are deliberately not button-count dependent: a project may have a
 * demo, a repo, both, or neither, and the footer renders only the links that
 * exist.
 */
import {
	HardDrive,
	ListChecks,
	Terminal,
	Braces,
	Globe,
	Wrench,
	BookOpen,
	FileText,
	Github,
	Linkedin,
	ExternalLink,
	TriangleAlert,
} from 'lucide-astro';
import type { Project } from '../data/projects';

interface Props {
	project: Project;
}

const { project } = Astro.props;

const ICONS = {
	drive: HardDrive,
	tracker: ListChecks,
	terminal: Terminal,
	compiler: Braces,
	web: Globe,
	tool: Wrench,
} as const;

const STATUS_LABEL: Record<Project['status'], string> = {
	active: 'active',
	archived: 'public archive',
	inactive: 'inactive',
};

const Icon = ICONS[project.icon];
const menuId = `menu-${project.id}`;

const links = [
	project.live && { label: 'live deployment', href: project.live, icon: ExternalLink },
	project.repo && { label: 'repository', href: project.repo, icon: Github },
	project.docs && { label: 'docs', href: project.docs, icon: BookOpen },
	project.post && { label: 'linkedin post', href: project.post, icon: Linkedin },
].filter(Boolean) as Array<{ label: string; href: string; icon: typeof ExternalLink }>;
---

<li
	class="card relative flex flex-col rounded-md border border-[#3d3846] bg-[#1c1c1c]"
	data-status={project.status}
	itemscope
	itemtype="https://schema.org/SoftwareSourceCode"
>
	<div
		class="card-bar flex items-center justify-between gap-2 rounded-t-[5px] border-b border-[#3d3846] bg-[#303030] px-2 py-[0.3rem] select-none"
	>
		<span class="card-dots flex gap-1" aria-hidden="true">
			<span class="size-1.5 rounded-full bg-[#e01b24]"></span>
			<span class="size-1.5 rounded-full bg-[#e5a50a]"></span>
			<span class="size-1.5 rounded-full bg-[#33d17a]"></span>
		</span>
		<div class="card-actions flex items-center gap-1">
			{
				project.status === 'archived' ? (
					<span
						class="card-status card-status--archived"
						title="This is a legacy project that is no longer supported and is only a public archive"
						aria-describedby={`tip-${project.id}`}
					>
						<TriangleAlert size={13} strokeWidth={2} aria-hidden="true" />
						<span class="card-status-label">{STATUS_LABEL[project.status]}</span>
					</span>
				) : (
					project.status !== 'active' && <span class="card-status">{STATUS_LABEL[project.status]}</span>
				)
			}
			{
				/*
				 * A project with a write-up keeps its menu on the title, and the
				 * write-up is offered inside that menu as "Project Description".
				 * This icon is the direct route to it, mirroring the achievements
				 * cards.
				 */
				project.detail && (
					<a
						class="card-action inline-flex size-4.5 items-center justify-center rounded-[3px] text-[#8a8a8a] no-underline hover:bg-[#3d3846] hover:text-[#deddda] focus-visible:outline focus-visible:outline-[#26a269] focus-visible:outline-offset-1"
						href={project.detail}
						aria-label={`${project.name} Project Description`}
						title="Project Description"
					>
						<FileText size={12} strokeWidth={1.5} aria-hidden="true" />
					</a>
				)
			}
			{
				links.map((link) => {
					const LinkIcon = link.icon;
					return (
						<a
							class="card-action inline-flex size-4.5 items-center justify-center rounded-[3px] text-[#8a8a8a] no-underline hover:bg-[#3d3846] hover:text-[#deddda] focus-visible:outline focus-visible:outline-[#26a269] focus-visible:outline-offset-1"
							href={link.href}
							target="_blank"
							rel="noreferrer"
							aria-label={`${project.name} ${link.label}`}
							title={link.label}
						>
							<LinkIcon size={12} strokeWidth={1.5} aria-hidden="true" />
						</a>
					);
				})
			}
		</div>
	</div>

	{
		project.status === 'archived' && (
			<span class="card-tooltip" role="tooltip" id={`tip-${project.id}`}>
				This is a legacy project that is no longer supported and only exists as a public archive.
			</span>
		)
	}

	<div class="card-body flex items-start gap-[0.6rem] rounded-b-[5px] p-3">
		<span
			class="card-icon flex size-7 shrink-0 items-center justify-center rounded-sm border border-[#3d3846] text-[#26a269]"
			aria-hidden="true"
		>
			<Icon size={16} strokeWidth={1.5} />
		</span>
		<div class="card-text min-w-0">
			<h2 class="m-0 text-[0.8125rem] font-medium leading-[1.4]">
				<button
					type="button"
					class="card-open cursor-pointer border-0 bg-transparent p-0 text-left text-[0.8125rem] font-[inherit] font-medium leading-[1.4] text-white"
					data-menu={menuId}
					aria-haspopup="dialog"
				>
					{project.name}
				</button>
			</h2>
			<p class="card-summary mt-[0.15rem] mb-0 text-[0.6875rem] leading-normal text-[#a5a3a9]">
				{project.summary}
			</p>

			{/*
			 * The long description is kept in the DOM for crawlers, SEO engines,
			 * and LLM parsers, but clipped out of the visible layout. It is
			 * skipped when it would only repeat the summary.
			 */}
			{project.description !== project.summary && (
				<p class="card-description sr-only" itemprop="description">
					{project.description}
				</p>
			)}
		</div>
	</div>
</li>

<style>
	.card-actions {
		/* The title's overlay covers the whole tile, so the bar's controls have
		   to sit above it to stay clickable. */
		position: relative;
		z-index: 1;
	}

	.card-status {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		margin-right: 0.25rem;
		color: #a5a3a9;
		font-size: 0.625rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.card-status--archived {
		gap: 0.2rem;
		color: #f9c23c;
	}

	.card-status-label {
		font-size: 0.5625rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	/*
	 * Archived cards explain themselves on hover/focus. The bubble hangs below
	 * the tile, right-aligned, and floats above the grid so it never reflows the
	 * layout or covers the card's own title and summary.
	 */
	.card-tooltip {
		position: absolute;
		top: calc(100% + 0.4rem);
		right: 0;
		z-index: 20;
		width: max-content;
		max-width: min(19rem, calc(100vw - 3rem));
		padding: 0.4rem 0.5rem;
		border: 1px solid #6b5a2a;
		border-radius: 4px;
		background: #2a2416;
		box-shadow: 0 6px 16px rgba(0, 0, 0, 0.55);
		color: #f9c23c;
		font-size: 0.6875rem;
		line-height: 1.45;
		text-align: left;
		pointer-events: none;
		opacity: 0;
		visibility: hidden;
		transform: translateY(-2px);
		transition:
			opacity 120ms ease-out,
			transform 120ms ease-out,
			visibility 120ms;
	}

	.card[data-status='archived']:hover .card-tooltip,
	.card[data-status='archived']:focus-within .card-tooltip {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		.card-tooltip {
			transition: none;
		}
	}

	.card:hover {
		border-color: #5a5560;
	}

	.card:focus-within {
		outline: 1px solid #26a269;
		outline-offset: 2px;
	}

	.card-open::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 6px;
	}

	.card-open:focus-visible {
		outline: none;
	}

	.card:hover .card-open {
		color: #26a269;
	}

	.card-action:hover {
		background: #3d3846;
		color: #deddda;
	}

	.card-action:focus-visible {
		outline: 1px solid #26a269;
		outline-offset: 1px;
	}
</style>
