---
import Layout from "@/components/static/layout.astro";
import GreetingText from "@/components/dynamic/GreetingText";
import Navbar from "@/components/dynamic/Navbar";

const birthday = 1117650600;
const currentTime = Date.now() / 1000;
const age = Math.floor((currentTime - birthday) / (365.25 * 24 * 3600));
---

<Layout>
	<Navbar client:visible />
	<main class="mx-auto flex min-h-screen w-full max-w-3xl flex-col gap-12 px-6 pb-12 pt-24 sm:px-8">
		<section class="flex min-h-[calc(100vh-9rem)] flex-col justify-between gap-10">
			<div class="space-y-6">
				<p class="text-sm uppercase tracking-[0.35em] text-white/40">
					Mobile view
				</p>

				<p class="text-lg text-white/80 sm:text-xl">
					<GreetingText initial="Hello!" client:visible />
				</p>

				<h1 class="max-w-xl text-4xl font-semibold tracking-tight text-white sm:text-5xl">
					I&apos;m Angad Bhalla
				</h1>

				<p class="max-w-xl text-base leading-7 text-white/70 sm:text-lg sm:leading-8">
					I&apos;m {age}. I like playing Minecraft, watching Marvel &amp; DC, drinking coffee and building cool things for me and my friends. I&apos;m also lactose intolerant.
				</p>
			</div>

			<div class="grid gap-3 rounded-3xl border border-white/10 bg-white/5 p-4 text-sm text-white/80 shadow-2xl shadow-black/20 backdrop-blur-xl sm:grid-cols-3">
				<a href="#about" class="rounded-2xl border border-white/10 bg-black/20 px-4 py-3 transition-colors hover:bg-black/30">
					About
				</a>
				<a href="/projects" class="rounded-2xl border border-white/10 bg-black/20 px-4 py-3 transition-colors hover:bg-black/30">
					Projects
				</a>
				<a href="/notes" class="rounded-2xl border border-white/10 bg-black/20 px-4 py-3 transition-colors hover:bg-black/30">
					Notes
				</a>
			</div>
		</section>

		<section id="about" class="space-y-5 border-t border-white/10 pt-10">
			<div class="space-y-2">
				<h2 class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">
					My Philosophy
				</h2>
				<p class="text-xs uppercase tracking-[0.45em] text-white/40">
					On Building Things
				</p>
			</div>

			<div class="space-y-4 text-sm leading-7 text-white/70 sm:text-base sm:leading-8">
				<p>
					I think the best engineers treat software the same way a craftsman treats his work. Every project is another chance to create something beautiful, and the only way to learn is to make mistakes.
				</p>

				<p>
					The most fun projects tend to start off with a <span class="text-white italic">"I know this sounds weird but what if-"</span>. That&apos;s the kind of energy I like to build with.
				</p>

				<p>
					That&apos;s why I care so much about every major project I&apos;ve built. Each one has a story behind it.
				</p>
			</div>
		</section>
	</main>
</Layout>