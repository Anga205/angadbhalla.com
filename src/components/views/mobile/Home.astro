---
import Layout from "@/components/static/layout.astro";
---

<Layout>
    <main class="flex min-h-screen items-center justify-center px-8">
        <div class="max-w-md">
            <p class="mb-3 text-xs uppercase tracking-[0.4em] text-white/40">
                Mobile View Error
            </p>

            <h1 class="text-4xl font-semibold tracking-tight text-white">
                This site isn't ready for phones yet.
            </h1>

            <p class="mt-6 leading-8 text-white/70">
                I designed this website around a desktop experience first.
                Rather than shipping something I'm not happy with, I'm building
                a dedicated mobile version.
            </p>

            <p class="mt-6 text-white/80">
                Expected completion:&nbsp;
                <span class="font-medium text-white">
                    July&nbsp;31,&nbsp;2026
                </span>
            </p>

            <div class="mt-10 flex gap-4">
                <a
                    href="mailto:sayhi@angadbhalla.com"
                    class="text-white/60 transition hover:text-white"
                >
                    Contact
                </a>

                <a
                    href="https://github.com/Anga205"
                    class="text-white/60 transition hover:text-white"
                >
                    GitHub
                </a>
            </div>
        </div>
    </main>
</Layout>