---
import GreetingText from "@/components/dynamic/GreetingText";
import { Mouse, ChevronDown } from "lucide-astro";
import ScrollReminderScript from "@/components/views/shared/ScrollReminderScript.astro";

const birthday = 1117650600;
const currentTime = Date.now() / 1000;
const age = Math.floor((currentTime - birthday) / (365.25 * 24 * 3600));
---

<section class="relative h-screen snap-start">
    <div class="flex h-full w-full">
        <div class="w-1/5"></div>
        <div class="flex w-2/5 items-center">
            <div data-hero-copy>
                <p class="mb-4 text-lg text-white/80 sm:text-xl">
                    <GreetingText initial="Hello!" client:visible />
                </p>
                <h1
                    class="max-w-4xl text-5xl font-semibold tracking-tight text-white sm:text-6xl lg:text-7xl"
                >
                    I&apos;m Angad Bhalla
                </h1>
                <p
                    class="mt-5 max-w-2xl text-base leading-8 text-white/70 sm:text-lg"
                >
                    I'm {age}. I like playing Minecraft, watching Marvel &amp;
                    DC, drinking coffee and building cool things for me and my
                    friends. I'm also lactose intolerant.
                </p>
            </div>
        </div>
        <div class="w-1/5"></div>
        <div class="w-1/5"></div>
    </div>
    <div
        id="scroll-indicator"
        class="pointer-events-none absolute bottom-8 left-1/2 flex -translate-x-1/2 items-center text-white/40 opacity-0 transition-opacity duration-700 gap-x-5"
    >
        <Mouse class="h-7 w-7" />

        <span class="mt-1 text-xs tracking-wide"> Scroll </span>

        <ChevronDown id="scroll-arrow" class="mt-1 h-4 w-4" />
    </div>
    <ScrollReminderScript />
</section>
