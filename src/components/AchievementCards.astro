---
/**
 * AchievementCards.astro
 *
 * The /achievements and /university index: every achievement as a compact
 * card, grouped by category, inside a GNOME-style window.
 *
 * The card itself lives in AchievementCard.astro and the link menu in
 * LinkMenu.astro; this component owns the page shell, the grouping, and the
 * per-group headings.
 */
import { FileText, Github, Info, Linkedin, ExternalLink, Youtube, Heart, Code } from 'lucide-astro';
import {
	groupByCategory,
	opensMenu,
	type AchievementGroup,
	type LinkIcon,
} from '../data/achievements';
import AchievementCard from './AchievementCard.astro';
import LinkMenu, { type MenuLink } from './LinkMenu.astro';
import Window from './Window.astro';
import LeetCode from './icons/LeetCode.astro';

interface Props {
	/** Groups to render. Defaults to the achievements index (no university). */
	groups?: AchievementGroup[];
	/** Window titlebar text. */
	windowTitle?: string;
	/** Shell prompt line. */
	prompt?: string;
	/** Page heading. */
	heading?: string;
	/** Section id, used for the scroll container. */
	sectionId?: string;
	/** Base path for detail pages, e.g. /achievements or /university. */
	detailBase?: string;
	/** Render entries as LinkedIn-style role rows (position, org, team). */
	roleMode?: boolean;
	/** Keyword-rich intro paragraph rendered under the heading. */
	intro?: string;
}

const {
	groups = groupByCategory(),
	windowTitle = 'anga@portfolio — achievements',
	prompt = '$ ls ~/achievements',
	heading = 'achievements',
	sectionId = 'achievements',
	detailBase = '/achievements',
	roleMode = false,
	intro,
} = Astro.props;

const LINK_ICONS: Record<LinkIcon, typeof Linkedin> = {
	linkedin: Linkedin,
	info: Info,
	github: Github,
	external: ExternalLink,
	code: Code,
	heart: Heart,
	youtube: Youtube,
	leetcode: LeetCode as unknown as typeof Linkedin,
};

/** Cards that open a menu, with the links that menu should list. */
const menuCards = groups
	.flatMap((group) => group.items)
	.filter(
		(achievement) =>
			opensMenu(achievement) &&
			((achievement.links?.length ?? 0) > 0 || Boolean(achievement.pageMenu)),
	);
---

<section
	class="page achievements ml-72 h-screen overflow-y-auto bg-[#171717] p-8 max-[639px]:ml-0 max-[639px]:px-4 max-[639px]:pt-4 max-[639px]:pb-24"
	id={sectionId}
>
	<Window title={windowTitle} width="wide">
		<p class="prompt mb-3 text-[0.75rem] text-[#26a269]">{prompt}</p>
		<h1 class="mb-8 text-[1.35rem] font-normal">{heading}</h1>

		{
			intro && (
				<p class="intro mb-6 max-w-[68ch] text-[#a5a3a9]">{intro}</p>
			)
		}

		{
			groups.map((group) => (
				<section class="group" aria-labelledby={`group-${group.category}`}>
					<div class="group-head mb-4">
						<h2
							class="m-0 text-[0.75rem] font-normal tracking-[0.06em] text-[#26a269] uppercase"
							id={`group-${group.category}`}
						>
							{group.label}
						</h2>
						{/*
						 * The count and blurb are kept in the DOM for crawlers and
						 * scrapers, but they are not part of the visible layout: the
						 * heading alone is enough for a reader.
						 */}
						<span class="sr-only" aria-hidden="true">
							{String(group.items.length).padStart(2, '0')}
						</span>
						<span class="sr-only" aria-hidden="true">
							{group.blurb}
						</span>
					</div>

					<ul class="grid m-0 list-none grid-cols-1 gap-3 p-0">
						{group.items.map((achievement) => (
							<AchievementCard
								achievement={achievement}
								detailBase={detailBase}
								roleMode={roleMode}
							/>
						))}
					</ul>
				</section>
			))
		}
	</Window>
</section>

{
	menuCards.map((achievement) => {
		const links = achievement.links ?? [];
		// `pageMenu` entries keep their detail page, so the menu offers it
		// first as "Activity Description" before the external links.
		const pageHref = achievement.pageMenu
			? (achievement.href ?? `${detailBase}/${achievement.slug}`)
			: undefined;

		const menuLinks: MenuLink[] = [
			...(pageHref ? [{ label: 'Activity Description', href: pageHref, icon: FileText }] : []),
			...links.map((link) => ({
				label: link.label,
				href: link.href,
				icon: LINK_ICONS[link.icon ?? 'external'],
				external: true,
			})),
		];

		return (
			<LinkMenu id={`menu-${achievement.slug}`} title={achievement.title} links={menuLinks} />
		);
	})
}

<style>
	/*
	 * Only the group rhythm lives here. Everything that styles a card belongs
	 * to AchievementCard.astro, because Astro scopes styles to the component
	 * that renders the element.
	 */
	.group + .group {
		margin-top: 2.25rem;
		padding-top: 2rem;
		border-top: 1px solid #262626;
	}
</style>

<script>
	import { initLeetCodeCounts } from '../scripts/achievement-cards';

	initLeetCodeCounts(document);
</script>
