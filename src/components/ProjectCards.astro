---
/**
 * ProjectCards.astro
 *
 * The /projects index: every project as a card inside a GNOME-style window.
 *
 * Cards are deliberately not button-count dependent. A project may have a
 * demo, a repo, both, or neither; the footer renders only the links that
 * exist, and the card body keeps the same height either way.
 *
 * Status is part of the data model, so an old project can be marked archived
 * or inactive without changing the layout.
 */
import {
	HardDrive,
	ListChecks,
	Terminal,
	Braces,
	Globe,
	Wrench,
	Play,
	BookOpen,
	Github,
	Archive,
	CircleSlash,
} from 'lucide-astro';
import { PROJECTS, type Project } from '../data/projects';

const ICONS = {
	drive: HardDrive,
	tracker: ListChecks,
	terminal: Terminal,
	compiler: Braces,
	web: Globe,
	tool: Wrench,
} as const;

const STATUS_LABEL: Record<Project['status'], string> = {
	active: 'active',
	archived: 'public archive',
	inactive: 'inactive',
};

const STATUS_ICON = {
	archived: Archive,
	inactive: CircleSlash,
} as const;
---

<section class="projects" id="projects">
	<div class="window">
		<div class="headerbar">
			<span class="dots" aria-hidden="true">
				<span></span><span></span><span></span>
			</span>
			<span class="title">anga@portfolio — projects</span>
			<span aria-hidden="true"></span>
		</div>

		<div class="body">
			<p class="prompt">$ ls ~/portfolio/projects</p>
			<h1>projects</h1>
			<p class="lede">
				Things I have built. Some are maintained, some are archives, and some are here because
				the code still explains the idea.
			</p>

			<ul class="grid">
				{PROJECTS.map((project) => {
					const Icon = ICONS[project.icon];
					const StatusIcon = project.status === 'active' ? null : STATUS_ICON[project.status];
					return (
						<li class="card" data-status={project.status}>
							<div class="card-head">
								<span class="card-icon" aria-hidden="true">
									<Icon size={18} strokeWidth={1.5} />
								</span>
								<div class="card-title">
									<h2>{project.name}</h2>
									<p class="card-summary">{project.summary}</p>
								</div>
							</div>

							<p class="card-description">{project.description}</p>

							<div class="card-meta">
								<span class="card-year">{project.year}</span>
								<ul class="stack">
									{project.stack.map((item) => (
										<li>{item}</li>
									))}
								</ul>
							</div>

							{project.status !== 'active' && (
								<p class="status" data-status={project.status}>
									{StatusIcon && <StatusIcon size={12} strokeWidth={1.5} aria-hidden="true" />}
									{STATUS_LABEL[project.status]}
								</p>
							)}

							<div class="card-actions">
								{project.demo && (
									<a class="action" href={project.demo}>
										<Play size={13} strokeWidth={1.5} aria-hidden="true" />
										demo
									</a>
								)}
								{project.repo && (
									<a class="action" href={project.repo}>
										<Github size={13} strokeWidth={1.5} aria-hidden="true" />
										repository
									</a>
								)}
								{project.docs && (
									<a class="action" href={project.docs}>
										<BookOpen size={13} strokeWidth={1.5} aria-hidden="true" />
										docs
									</a>
								)}
							</div>
						</li>
					);
				})}
			</ul>
		</div>
	</div>
</section>

<style>
	.projects {
		margin-left: 18rem;
		height: 100vh;
		overflow-y: auto;
		padding: 2rem;
		background: #171717;
	}

	.window {
		max-width: 64rem;
		margin: 0 auto;
		overflow: hidden;
		border: 1px solid #3d3846;
		border-radius: 6px;
		background: #000000;
		box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
	}

	.headerbar {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 0.75rem;
		border-bottom: 1px solid #3d3846;
		background: #303030;
		color: #deddda;
		font-size: 0.75rem;
		letter-spacing: 0.02em;
		user-select: none;
	}

	.dots {
		display: flex;
		gap: 0.375rem;
	}

	.dots span {
		width: 0.625rem;
		height: 0.625rem;
		border-radius: 999px;
	}

	.dots span:nth-child(1) {
		background: #e01b24;
	}

	.dots span:nth-child(2) {
		background: #e5a50a;
	}

	.dots span:nth-child(3) {
		background: #33d17a;
	}

	.title {
		text-align: center;
		white-space: nowrap;
	}

	.body {
		padding: 1.75rem;
		color: #ffffff;
		font-size: 0.875rem;
		line-height: 1.75;
	}

	.prompt {
		margin: 0 0 0.75rem;
		color: #26a269;
		font-size: 0.75rem;
	}

	h1 {
		margin: 0 0 0.5rem;
		font-size: 1.35rem;
		font-weight: 400;
	}

	.lede {
		margin: 0 0 1.75rem;
		max-width: 62ch;
		color: #a5a3a9;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.card {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1rem;
		border: 1px solid #3d3846;
		border-radius: 6px;
		background: #1c1c1c;
	}

	.card[data-status='archived'],
	.card[data-status='inactive'] {
		background: #191919;
	}

	.card-head {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
	}

	.card-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		flex-shrink: 0;
		border: 1px solid #3d3846;
		border-radius: 4px;
		color: #26a269;
	}

	.card-title {
		min-width: 0;
	}

	.card-title h2 {
		margin: 0;
		color: #ffffff;
		font-size: 0.9375rem;
		font-weight: 500;
		line-height: 1.4;
	}

	.card-summary {
		margin: 0.15rem 0 0;
		color: #a5a3a9;
		font-size: 0.75rem;
		line-height: 1.5;
	}

	.card-description {
		margin: 0;
		color: #a5a3a9;
		font-size: 0.8125rem;
		line-height: 1.65;
	}

	.card-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		color: #737373;
		font-size: 0.6875rem;
	}

	.card-year {
		color: #737373;
	}

	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.stack li {
		padding: 0.05rem 0.35rem;
		border: 1px solid #3d3846;
		border-radius: 3px;
		color: #a5a3a9;
	}

	.status {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin: 0;
		color: #a5a3a9;
		font-size: 0.6875rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.status[data-status='archived'] {
		color: #e5a50a;
	}

	.status[data-status='inactive'] {
		color: #737373;
	}

	.card-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: auto;
		padding-top: 0.25rem;
	}

	.action {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.25rem 0.55rem;
		border: 1px solid #3d3846;
		border-radius: 3px;
		color: #deddda;
		font-size: 0.75rem;
		text-decoration: none;
	}

	.action:hover {
		border-color: #5a5560;
		background: #262626;
		color: #ffffff;
	}

	.action:focus-visible {
		outline: 1px solid #26a269;
		outline-offset: 2px;
	}

	@media (max-width: 639px) {
		.projects {
			margin-left: 0;
			padding: 1rem 1rem 6rem;
		}

		.body {
			padding: 1.25rem;
		}

		.grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
