---
/**
 * ProjectCards.astro
 *
 * The /projects index: every project as a card inside a GNOME-style window.
 *
 * The card lives in ProjectCard.astro and the link menu in LinkMenu.astro;
 * this component owns the page shell and the menu wiring.
 */
import { BookOpen, Github, Linkedin, ExternalLink } from 'lucide-astro';
import { PROJECTS } from '../data/projects';
import LinkMenu, { type MenuLink } from './LinkMenu.astro';
import ProjectCard from './ProjectCard.astro';
import Window from './Window.astro';
---

<section
	class="projects ml-72 h-screen overflow-y-auto bg-[#171717] p-8 max-[639px]:ml-0 max-[639px]:px-4 max-[639px]:pt-4 max-[639px]:pb-24"
	id="projects"
>
	{/*
	 * `clip={false}` because archived cards render a tooltip that hangs below
	 * the card box; `overflow-hidden` on the window would cut it off.
	 */}
	<Window title="anga@portfolio — projects" width="wide" clip={false}>
		<p class="prompt mb-3 text-[0.75rem] text-[#26a269]">$ ls ~/portfolio/projects</p>
		<h1 class="mb-8 text-[1.35rem] font-normal">projects</h1>

		<ul class="grid m-0 grid-cols-1 list-none gap-3 p-0">
			{PROJECTS.map((project) => <ProjectCard project={project} />)}
		</ul>
	</Window>
</section>

{
	PROJECTS.map((project) => {
		const links: MenuLink[] = [
			project.live && {
				label: 'live deployment',
				href: project.live,
				icon: ExternalLink,
				external: true,
			},
			project.repo && { label: 'repository', href: project.repo, icon: Github, external: true },
			project.docs && { label: 'docs', href: project.docs, icon: BookOpen, external: true },
			project.post && {
				label: 'linkedin post',
				href: project.post,
				icon: Linkedin,
				external: true,
			},
		].filter(Boolean) as MenuLink[];

		return <LinkMenu id={`menu-${project.id}`} title={project.name} links={links} />;
	})
}
