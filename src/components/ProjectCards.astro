---
/**
 * ProjectCards.astro
 *
 * The /projects index: every project as a card inside a GNOME-style window.
 *
 * Cards are deliberately not button-count dependent. A project may have a
 * demo, a repo, both, or neither; the footer renders only the links that
 * exist, and the card body keeps the same height either way.
 *
 * Status is part of the data model, so an old project can be marked archived
 * or inactive without changing the layout.
 */
import {
	HardDrive,
	ListChecks,
	Terminal,
	Braces,
	Globe,
	Wrench,
	Play,
	BookOpen,
	Github,
	Archive,
	CircleSlash,
} from 'lucide-astro';
import { PROJECTS, type Project } from '../data/projects';

const ICONS = {
	drive: HardDrive,
	tracker: ListChecks,
	terminal: Terminal,
	compiler: Braces,
	web: Globe,
	tool: Wrench,
} as const;

const STATUS_LABEL: Record<Project['status'], string> = {
	active: 'active',
	archived: 'public archive',
	inactive: 'inactive',
};

const STATUS_ICON = {
	archived: Archive,
	inactive: CircleSlash,
} as const;
---

<section
	class="projects ml-72 h-screen overflow-y-auto bg-[#171717] p-8 max-[639px]:ml-0 max-[639px]:px-4 max-[639px]:pt-4 max-[639px]:pb-24"
	id="projects"
>
	<div
		class="window mx-auto max-w-5xl overflow-hidden rounded-md border border-[#3d3846] bg-[#000000] shadow-[0_25px_50px_-12px_rgba(0,0,0,0.25)]"
	>
		<div
			class="headerbar grid grid-cols-[1fr_auto_1fr] items-center gap-2 border-b border-[#3d3846] bg-[#303030] px-3 py-2 text-[0.75rem] tracking-[0.02em] text-[#deddda] select-none"
		>
			<span class="dots flex gap-1.5" aria-hidden="true">
				<span class="size-2.5 rounded-full bg-[#e01b24]"></span><span class="size-2.5 rounded-full bg-[#e5a50a]"></span><span class="size-2.5 rounded-full bg-[#33d17a]"></span>
			</span>
			<span class="title text-center whitespace-nowrap">anga@portfolio — projects</span>
			<span aria-hidden="true"></span>
		</div>

		<div class="body p-7 text-[0.875rem] leading-[1.75] text-white">
			<p class="prompt mb-3 text-[0.75rem] text-[#26a269]">$ ls ~/portfolio/projects</p>
			<h1 class="mb-2 text-[1.35rem] font-normal">projects</h1>
			<p class="lede mb-7 max-w-[62ch] text-[#a5a3a9]">
				Things I have built. Some are maintained, some are archives, and some are here because
				the code still explains the idea.
			</p>

			<ul class="grid grid-cols-[repeat(auto-fill,minmax(19rem,1fr))] gap-4 m-0 list-none p-0 max-[639px]:grid-cols-[minmax(0,1fr)]">
				{PROJECTS.map((project) => {
					const Icon = ICONS[project.icon];
					const StatusIcon = project.status === 'active' ? null : STATUS_ICON[project.status];
					return (
						<li
							class={`card flex flex-col gap-3 rounded-md border border-[#3d3846] p-4 ${project.status === 'active' ? 'bg-[#1c1c1c]' : 'bg-[#191919]'}`}
							data-status={project.status}
						>
							<div class="card-head flex items-start gap-3">
								<span
									class="card-icon flex size-8 shrink-0 items-center justify-center rounded-sm border border-[#3d3846] text-[#26a269]"
									aria-hidden="true"
								>
									<Icon size={18} strokeWidth={1.5} />
								</span>
								<div class="card-title min-w-0">
									<h2 class="m-0 text-[0.9375rem] font-medium leading-[1.4] text-white">{project.name}</h2>
									<p class="card-summary mt-[0.15rem] mb-0 text-[0.75rem] leading-normal text-[#a5a3a9]">{project.summary}</p>
								</div>
							</div>

							<p class="card-description m-0 text-[0.8125rem] leading-[1.65] text-[#a5a3a9]">{project.description}</p>

							<div class="card-meta flex flex-wrap items-center gap-2 text-[0.6875rem] text-dim">
								<span class="card-year text-dim">{project.year}</span>
								<ul class="stack m-0 flex list-none flex-wrap gap-[0.35rem] p-0">
									{project.stack.map((item) => (
										<li class="rounded-[3px] border border-[#3d3846] px-[0.35rem] py-[0.05rem] text-[#a5a3a9]">{item}</li>
									))}
								</ul>
							</div>

							{project.status !== 'active' && (
								<p class="status m-0 inline-flex items-center gap-[0.35rem] text-[0.6875rem] tracking-[0.04em] text-[#a5a3a9] uppercase" data-status={project.status}>
									{StatusIcon && <StatusIcon size={12} strokeWidth={1.5} aria-hidden="true" />}
									{STATUS_LABEL[project.status]}
								</p>
							)}

							<div class="card-actions mt-auto flex flex-wrap gap-2 pt-1">
								{project.demo && (
									<a class="action inline-flex items-center gap-[0.35rem] rounded-[3px] border border-[#3d3846] px-[0.55rem] py-1 text-[0.75rem] text-[#deddda] no-underline hover:border-[#5a5560] hover:bg-line hover:text-white focus-visible:outline focus-visible:outline-[#26a269] focus-visible:outline-offset-2" href={project.demo}>
										<Play size={13} strokeWidth={1.5} aria-hidden="true" />
										demo
									</a>
								)}
								{project.repo && (
									<a class="action inline-flex items-center gap-[0.35rem] rounded-[3px] border border-[#3d3846] px-[0.55rem] py-1 text-[0.75rem] text-[#deddda] no-underline hover:border-[#5a5560] hover:bg-line hover:text-white focus-visible:outline-1 focus-visible:outline-[#26a269] focus-visible:outline-offset-2" href={project.repo}>
										<Github size={13} strokeWidth={1.5} aria-hidden="true" />
										repository
									</a>
								)}
								{project.docs && (
									<a class="action inline-flex items-center gap-[0.35rem] rounded-[3px] border border-[#3d3846] px-[0.55rem] py-1 text-[0.75rem] text-[#deddda] no-underline hover:border-[#5a5560] hover:bg-line hover:text-white focus-visible:outline focus-visible:outline-[#26a269] focus-visible:outline-offset-2" href={project.docs}>
										<BookOpen size={13} strokeWidth={1.5} aria-hidden="true" />
										docs
									</a>
								)}
							</div>
						</li>
					);
				})}
			</ul>
		</div>
	</div>
</section>

<style>
	.status[data-status='archived'] {
		color: #e5a50a;
	}

	.status[data-status='inactive'] {
		color: #737373;
	}

</style>
