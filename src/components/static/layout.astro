---
import Header from "./header.astro";
import "@/styles/global.css";

const {
	title,
	description,
	canonicalPath = "/",
} = Astro.props;
---

<html lang="en">
	<Header title={title} description={description} canonicalPath={canonicalPath} />
	<body class="min-h-screen overflow-x-hidden bg-neutral-900 text-white">
		<div class="min-h-screen">
			<slot />
		</div>
	</body>
</html>
