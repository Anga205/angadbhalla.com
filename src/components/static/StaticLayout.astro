---
import PageHead from "./PageHead.astro";
import StaticNavbar from "./StaticNavbar.astro";
import "@/styles/global.css";

const {
	title,
	description,
	canonicalPath,
} = Astro.props;
---

<html lang="en" style="scroll-snap-type: none;">
	<PageHead
		title={title}
		description={description}
		canonicalPath={canonicalPath}
	/>
	<body class="min-h-screen overflow-x-hidden bg-neutral-900 text-white" style="scroll-snap-type: none;">
		<StaticNavbar />
		<div class="mx-auto max-h-screen w-full max-w-6xl px-6 pb-16 pt-8 sm:px-8 lg:px-12">
			<slot />
		</div>
	</body>
</html>