---
import { ArrowRight, Menu } from "lucide-astro";

const pathname = Astro.url.pathname;

const links = [
	{ href: "/", label: "Home" },
	{ href: "/projects", label: "Projects" },
	// { href: "/resume", label: "Resume" },
	{ href: "/contact", label: "Contact" },
];

const isActive = (href: string) =>
	href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="border-b border-white/10 bg-neutral-900/80 backdrop-blur-xl">
	<div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-8">
		<a href="/" class="flex h-full items-center p-2">
			<img
				src="/anga.svg"
				alt="Anga Logo"
				class="spin-scale-hover h-full aspect-square"
			/>
		</a>

		<nav class="hidden items-center gap-8 text-sm text-white/60 md:flex">
			{
				links.map(({ href, label }) => (
					<a
						href={href}
						aria-current={isActive(href) ? "page" : undefined}
						class:list={[
							"transition-colors hover:text-white",
							isActive(href) && "text-white",
						]}
					>
						{label}
					</a>
				))
			}
		</nav>

		<details class="group relative md:hidden">
			<summary
				class="flex h-10 cursor-pointer list-none items-center gap-2 px-3 text-sm text-white/75 transition hover:border-white/20 hover:text-white [&::-webkit-details-marker]:hidden"
			>
				<Menu class="h-4 w-4" />
			</summary>

			<div
				class="absolute right-0 top-full z-20 mt-2 w-56 border border-white/10 bg-neutral-900 p-2"
			>
				<nav class="flex flex-col">
					{
						links.map(({ href, label }) => (
							<a
								href={href}
								aria-current={
									isActive(href) ? "page" : undefined
								}
								class:list={[
									"flex items-center justify-between px-3 py-3 text-sm text-white/70 transition hover:bg-white/5 hover:text-white",
									isActive(href) && "text-white",
								]}
							>
								<span>{label}</span>
								<ArrowRight class="h-4 w-4 text-white/30" />
							</a>
						))
					}
				</nav>
			</div>
		</details>
	</div>
</header>
