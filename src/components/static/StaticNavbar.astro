---
import {
	ArrowRight,
	Menu,
} from "lucide-astro";

const pathname = Astro.url.pathname;

const links = [
	{ href: "/", label: "Home" },
	{ href: "/projects", label: "Projects" },
	{ href: "/resume", label: "Resume" },
	{ href: "/contact", label: "Contact" },
];

const isActive = (href: string) =>
	href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="border-b border-white/10 bg-neutral-950/95 backdrop-blur-xl">
	<div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4 sm:px-8 lg:px-12">
		<a href="/" class="flex items-center gap-3 text-sm font-medium tracking-[0.24em] text-white/90">
			<span class="inline-flex h-8 items-center border border-white/10 px-3 text-[0.68rem] tracking-[0.35em] text-white/60">
				AB
			</span>
			<span class="hidden text-white/80 sm:inline">Angad Bhalla</span>
		</a>

		<nav class="hidden items-center gap-8 text-sm text-white/60 md:flex">
			{links.map(({ href, label }) => (
				<a
					href={href}
					aria-current={isActive(href) ? "page" : undefined}
					class:list={[
						"transition-colors hover:text-white",
						isActive(href) ? "text-white" : "",
					]}
				>
					{label}
				</a>
			))}
		</nav>

		<details class="group relative md:hidden">
			<summary class="flex cursor-pointer list-none items-center gap-2 border border-white/10 px-3 py-2 text-sm text-white/75 transition hover:border-white/20 hover:text-white [&::-webkit-details-marker]:hidden">
				<Menu class="h-4 w-4" />
				<span>Menu</span>
			</summary>
			<div class="absolute right-0 top-full z-20 mt-3 w-56 border border-white/10 bg-neutral-950 p-2 shadow-none">
				<nav class="flex flex-col">
					{links.map(({ href, label }) => (
						<a
							href={href}
							aria-current={isActive(href) ? "page" : undefined}
							class:list={[
								"flex items-center justify-between px-3 py-3 text-sm text-white/70 transition hover:bg-white/4 hover:text-white",
								isActive(href) ? "text-white" : "",
							]}
						>
							<span>{label}</span>
							<ArrowRight class="h-4 w-4 text-white/30" />
						</a>
					))}
				</nav>
		</div>
	</details>
	</div>
</header>