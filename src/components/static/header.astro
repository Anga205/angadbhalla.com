---
const SITE_URL = "https://angadbhalla.com";

const {
	title = "Angad Bhalla",
	description = "Angad Bhalla is a Software Engineer and Computer Science student at PES University specializing in systems programming, backend engineering, operating systems, Linux, distributed systems, infrastructure software, cloud storage, compiler design, robotics, and high-performance software.",
	canonicalPath = "/",
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, SITE_URL).toString();

const KEYWORDS = [
	"Angad Bhalla",
	"Software Engineer",
	"Systems Programming",
	"Backend Engineering",
	"Operating Systems",
	"Linux",
	"Go",
	"Golang",
	"C",
	"x86 Assembly",
	"Distributed Systems",
	"Infrastructure Engineering",
	"High Performance Computing",
	"Scalable Systems",
	"Cloud Storage",
	"Self Hosting",
	"Developer Tools",
	"Containerization",
	"Linux Namespaces",
	"cgroups",
	"Network Programming",
	"Kernel Development",
	"Bootloader",
	"Operating System Development",
	"Robotics",
	"Embedded Systems",
	"ESP32",
	"STM32",
	"Competitive Programming",
	"Open Source",
	"PES University",
	"Bengaluru"
].join(", ");

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Angad Bhalla",
	url: SITE_URL,
	image: `${SITE_URL}/og.png`,
	jobTitle: "Software Engineer",
	description,
	knowsAbout: [
		"Systems Programming",
		"Backend Engineering",
		"Operating Systems",
		"Linux",
		"Go",
		"Distributed Systems",
		"Infrastructure Engineering",
		"Containerization",
		"Compiler Design",
	],
	sameAs: [
		"https://github.com/Anga205/",
		"https://www.linkedin.com/in/anga",
		"https://www.reddit.com/u/anga205",
		"https://www.instagram.com/_anga205/",
	],
};
---

<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta name="generator" content={Astro.generator} />

	<title>{title}</title>

	<meta name="description" content={description} />
	<meta name="keywords" content={KEYWORDS} />
	<meta name="author" content="Angad Bhalla" />
	<meta name="creator" content="Angad Bhalla" />
	<meta name="publisher" content="Angad Bhalla" />

	<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

	<link rel="canonical" href={canonicalUrl} />

	<link rel="icon" href="/favicon.ico" sizes="any" />
	<link rel="icon" type="image/svg+xml" href="/anga.svg" />
	<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

	<meta name="theme-color" content="#0a0a0a" />
	<meta name="color-scheme" content="dark" />

	<meta property="og:type" content="website" />
	<meta property="og:url" content={canonicalUrl} />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:site_name" content="Angad Bhalla" />
	<meta property="og:image" content={`${SITE_URL}/og.png`} />

	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />
	<meta name="twitter:image" content={`${SITE_URL}/og.png`} />

	<meta name="format-detection" content="telephone=no" />

	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>