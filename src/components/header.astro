---
const SITE_URL = "https://angadbhalla.com";

const TITLE =
	"Angad Bhalla | Software Engineer • Systems Programming • Go • Linux • Backend Engineering";

const DESCRIPTION =
	"Angad Bhalla is a Software Engineer and Computer Science student at PES University specializing in systems programming, backend engineering, operating systems, Linux, distributed systems, infrastructure software, cloud storage, compiler design, robotics, and high-performance software.";

const KEYWORDS = [
	"Angad Bhalla",
	"Software Engineer",
	"Systems Programming",
	"Backend Engineering",
	"Operating Systems",
	"Linux",
	"Go",
	"Golang",
	"C",
	"x86 Assembly",
	"Distributed Systems",
	"Infrastructure Engineering",
	"High Performance Computing",
	"Scalable Systems",
	"Cloud Storage",
	"Self Hosting",
	"Developer Tools",
	"Containerization",
	"Linux Namespaces",
	"cgroups",
	"Network Programming",
	"Kernel Development",
	"Bootloader",
	"Operating System Development",
	"Robotics",
	"Embedded Systems",
	"ESP32",
	"STM32",
	"Competitive Programming",
	"Open Source",
	"PES University",
	"Bengaluru"
].join(", ");
---

<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta name="generator" content={Astro.generator} />

	<title>Angad Bhalla</title>

	<meta name="description" content={DESCRIPTION} />
	<meta name="keywords" content={KEYWORDS} />
	<meta name="author" content="Angad Bhalla" />
	<meta name="creator" content="Angad Bhalla" />
	<meta name="publisher" content="Angad Bhalla" />

	<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

	<link rel="canonical" href={SITE_URL} />

	<link rel="icon" href="/favicon.ico" />
	<link rel="icon" type="image/svg+xml" href="/anga.svg" />
	<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

	<meta name="theme-color" content="#0a0a0a" />
	<meta name="color-scheme" content="dark" />

	<meta property="og:type" content="website" />
	<meta property="og:url" content={SITE_URL} />
	<meta property="og:title" content={TITLE} />
	<meta property="og:description" content={DESCRIPTION} />
	<meta property="og:site_name" content="Angad Bhalla" />
	<meta property="og:image" content={`${SITE_URL}/og.png`} />

	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={TITLE} />
	<meta name="twitter:description" content={DESCRIPTION} />
	<meta name="twitter:image" content={`${SITE_URL}/og.png`} />

	<meta name="format-detection" content="telephone=no" />
</head>