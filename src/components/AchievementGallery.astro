---
/**
 * AchievementGallery.astro
 *
 * A thumbnail grid plus one native <dialog> lightbox per gallery.
 *
 * The dialog is the platform's own modal: focus trapping, Esc, and the
 * ::backdrop come for free. The script only fills it and handles arrow keys.
 *
 * Images are discovered from disk by galleryFor(), so adding a screenshot is
 * a file drop, not a code change.
 */
import { ArrowLeft, ArrowRight, X } from 'lucide-astro';
import type { GalleryImage } from '../data/achievements';

interface Props {
	images: GalleryImage[];
	/** Used for the dialog's accessible name. */
	title: string;
}

const { images, title } = Astro.props;
const dialogId = `gallery-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

{
	images.length > 0 && (
		<figure class="gallery m-0" data-gallery>
			<ul class="thumbs m-0 grid list-none grid-cols-[repeat(auto-fill,minmax(11rem,1fr))] gap-3 p-0 max-[639px]:grid-cols-[repeat(auto-fill,minmax(8rem,1fr))]">
				{images.map((image, index) => (
					<li>
						<button
							type="button"
							class="thumb relative block aspect-4/3 w-full cursor-zoom-in overflow-hidden rounded-sm border border-[#3d3846] bg-[#1c1c1c] p-0 hover:border-[#5a5560] focus-visible:outline-1 focus-visible:outline-[#26a269] focus-visible:outline-offset-2"
							data-index={index}
							data-caption={image.caption}
							aria-label={`expand image ${index + 1}: ${image.caption}`}
						>
							<img
								src={image.src}
								alt={image.alt}
								loading="lazy"
								decoding="async"
							/>
								<span class="thumb-index absolute right-[0.4rem] bottom-[0.35rem] rounded-[3px] bg-[rgba(0,0,0,0.7)] px-[0.3rem] py-[0.05rem] text-[0.625rem] tracking-[0.04em] text-[#a5a3a9]" aria-hidden="true">
								{String(index + 1).padStart(2, '0')}
							</span>
						</button>
					</li>
				))}
			</ul>

			<dialog class="lightbox" id={dialogId} aria-label={`${title} gallery`}>
				<div class="lightbox-inner flex flex-col gap-3 p-3">
					<div class="lightbox-bar flex items-center justify-between gap-2">
						<span class="lightbox-count text-[0.6875rem] tracking-[0.06em] text-dim" data-count aria-hidden="true" />
						<button type="button" class="lightbox-close inline-flex cursor-pointer items-center justify-center rounded-[3px] border border-[#3d3846] bg-transparent p-[0.3rem] text-[#deddda] hover:border-[#5a5560] hover:bg-line hover:text-white focus-visible:outline-1 focus-visible:outline-[#26a269] focus-visible:outline-offset-2" data-close aria-label="close gallery">
							<X size={14} strokeWidth={1.5} aria-hidden="true" />
						</button>
					</div>

					<div class="lightbox-stage grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-2 max-[639px]:grid-cols-[minmax(0,1fr)]">
						<button type="button" class="lightbox-nav inline-flex cursor-pointer items-center justify-center rounded-[3px] border border-[#3d3846] bg-transparent p-[0.3rem] text-[#deddda] hover:border-[#5a5560] hover:bg-line hover:text-white focus-visible:outline-1 focus-visible:outline-[#26a269] focus-visible:outline-offset-2 max-[639px]:hidden" data-prev aria-label="previous image">
							<ArrowLeft size={16} strokeWidth={1.5} aria-hidden="true" />
						</button>

						<div class="lightbox-frame grid min-h-0 place-items-center">
							{images.map((image, index) => (
								<img
									src={image.src}
									alt={image.alt}
									loading="lazy"
									decoding="async"
									data-slide={index}
									hidden={index !== 0}
								/>
							))}
						</div>

						<button type="button" class="lightbox-nav inline-flex cursor-pointer items-center justify-center rounded-[3px] border border-[#3d3846] bg-transparent p-[0.3rem] text-[#deddda] hover:border-[#5a5560] hover:bg-line hover:text-white focus-visible:outline focus-visible:outline-[#26a269] focus-visible:outline-offset-2 max-[639px]:hidden" data-next aria-label="next image">
							<ArrowRight size={16} strokeWidth={1.5} aria-hidden="true" />
						</button>
					</div>

					<p class="lightbox-caption m-0 min-h-5 text-[0.75rem] leading-[1.6] text-[#a5a3a9]" data-caption-text />
				</div>
			</dialog>
		</figure>
	)
}

<style>
	.thumb :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.lightbox {
		width: min(64rem, calc(100vw - 2rem));
		max-width: none;
		max-height: calc(100vh - 2rem);
		margin: auto;
		overflow: hidden;
		padding: 0;
		border: 1px solid #3d3846;
		border-radius: 6px;
		background: #000000;
		color: #ffffff;
	}

	.lightbox::backdrop {
		background: rgba(0, 0, 0, 0.82);
	}

	.lightbox-frame :global(img) {
		display: block;
		max-width: 100%;
		max-height: calc(100vh - 12rem);
		width: auto;
		height: auto;
		border: 1px solid #262626;
		border-radius: 4px;
	}

	.lightbox-frame :global(img[hidden]) {
		display: none;
	}

	@media (prefers-reduced-motion: no-preference) {
		.lightbox[open] {
			animation: lightbox-in 120ms ease-out;
		}

		@keyframes lightbox-in {
			from {
				opacity: 0;
			}
			to {
				opacity: 1;
			}
		}
	}
</style>

<script>
	const galleries = document.querySelectorAll<HTMLElement>('[data-gallery]');

	for (const gallery of galleries) {
		const found = gallery.querySelector<HTMLDialogElement>('dialog');
		if (!found) continue;

		const dialog: HTMLDialogElement = found;
		const slides = Array.from(dialog.querySelectorAll<HTMLImageElement>('[data-slide]'));
		const captionText = dialog.querySelector<HTMLElement>('[data-caption-text]');
		const counter = dialog.querySelector<HTMLElement>('[data-count]');
		const thumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>('.thumb'));

		let current = 0;

		function show(index: number) {
			if (slides.length === 0) return;
			current = (index + slides.length) % slides.length;

			slides.forEach((slide, position) => {
				slide.hidden = position !== current;
			});

			const caption = thumbs[current]?.dataset.caption ?? '';
			if (captionText) captionText.textContent = caption;
			if (counter) {
				counter.textContent = `${String(current + 1).padStart(2, '0')} / ${String(
					slides.length,
				).padStart(2, '0')}`;
			}
		}

		function open(index: number) {
			show(index);
			dialog.showModal();
		}

		thumbs.forEach((thumb, index) => {
			thumb.addEventListener('click', () => open(index));
		});

		dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
		dialog.querySelector('[data-prev]')?.addEventListener('click', () => show(current - 1));
		dialog.querySelector('[data-next]')?.addEventListener('click', () => show(current + 1));

		// Clicking the backdrop closes. The dialog element itself covers the
		// viewport, so compare against its own box rather than the target.
		dialog.addEventListener('click', (event) => {
			if (event.target !== dialog) return;
			const box = dialog.getBoundingClientRect();
			const outside =
				event.clientX < box.left ||
				event.clientX > box.right ||
				event.clientY < box.top ||
				event.clientY > box.bottom;
			if (outside) dialog.close();
		});

		dialog.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') {
				event.preventDefault();
				show(current - 1);
			} else if (event.key === 'ArrowRight') {
				event.preventDefault();
				show(current + 1);
			}
		});
	}
</script>
