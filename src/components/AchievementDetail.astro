---
/**
 * AchievementDetail.astro
 *
 * The long-form page for one achievement. Shared by /achievements/<slug> and
 * /university/<slug> so both indexes render identical detail pages.
 */
import Base from '../layouts/Base.astro';
import PortfolioMenu from './PortfolioMenu.astro';
import AchievementGallery from './AchievementGallery.astro';
import { CATEGORY_LABELS, galleryFor, type Achievement } from '../data/achievements';
import { ArrowLeft, ArrowUpRight } from 'lucide-astro';

interface Props {
	achievement: Achievement;
	/** Sibling achievements in the same category, for prev/next. */
	siblings: Achievement[];
	/** Base path for the index and sibling links, e.g. /achievements. */
	basePath: string;
	/** Label for the back link, e.g. "all achievements". */
	backLabel: string;
	/** Window titlebar prefix, e.g. "achievements". */
	section: string;
}

const { achievement, siblings, basePath, backLabel, section } = Astro.props;
const images = galleryFor(achievement.images);

// Tags and stack can be demoted to metadata when the pills add nothing.
const metaOnly = Boolean(achievement.metaOnly);
const highlights = achievement.detail.highlights ?? [];
const keywords = [...achievement.tags, ...(achievement.detail.stack ?? [])];

const position = siblings.findIndex((item) => item.slug === achievement.slug);
const previous = siblings[(position - 1 + siblings.length) % siblings.length];
const next = siblings[(position + 1) % siblings.length];
const showSiblings = siblings.length > 1;
---

<Base
	title={`anga / ${section} / ${achievement.slug}`}
	description={`${achievement.title} — ${achievement.result}. ${achievement.summary}`}
>
	<PortfolioMenu minimized />

	{metaOnly && <meta name="keywords" content={keywords.join(', ')} />}

	<main class="page ml-72 h-screen overflow-y-auto bg-[#171717] p-8 max-[639px]:ml-0 max-[639px]:px-4 max-[639px]:pt-4 max-[639px]:pb-24">
		<div class="window mx-auto max-w-240 overflow-hidden rounded-md border border-[#3d3846] bg-[#000000] shadow-[0_25px_50px_-12px_rgba(0,0,0,0.25)]">
			<div class="headerbar grid grid-cols-[1fr_auto_1fr] items-center gap-2 border-b border-[#3d3846] bg-[#303030] px-3 py-2 text-[0.75rem] tracking-[0.02em] text-[#deddda] select-none">
				<span class="dots flex gap-1.5" aria-hidden="true">
					<span class="size-2.5 rounded-full bg-[#e01b24]"></span><span class="size-2.5 rounded-full bg-[#e5a50a]"></span><span class="size-2.5 rounded-full bg-[#33d17a]"></span>
				</span>
				<span class="title overflow-hidden text-center text-ellipsis whitespace-nowrap">anga@portfolio — {section}/{achievement.slug}</span>
				<span aria-hidden="true"></span>
			</div>

			<div class="body p-7 text-[0.875rem] leading-[1.75] text-white max-[639px]:p-5">
				<nav class="crumbs mb-4 flex items-center gap-[0.4rem] text-[0.6875rem] text-dim" aria-label="Breadcrumb">
					<a class="text-dim no-underline hover:text-[#26a269] focus-visible:outline-1 focus-visible:outline-[#26a269] focus-visible:outline-offset-2" href={basePath}>{section}</a>
					<span aria-hidden="true">/</span>
					<span aria-current="page">{achievement.slug}</span>
				</nav>

				<p class="prompt mb-5 text-[0.75rem] text-[#26a269]">$ cat {section}/{achievement.slug}.md</p>

				<header class="head mb-7 border-b border-line pb-6">
					<h1 class="mb-[0.4rem] text-[1.35rem] font-normal">{achievement.title}</h1>
					<p class="summary mb-[0.9rem] max-w-[58ch] text-[#a5a3a9]">{achievement.summary}</p>

					<div class="meta flex flex-wrap items-center gap-2 text-[0.6875rem]">
						<span class="result rounded-[3px] border border-[#2f5c3f] bg-[rgba(38,162,105,0.1)] px-[0.35rem] py-[0.05rem] text-[#26a269]">{achievement.result}</span>
						<span class="meta-item text-dim">{achievement.date}</span>
						<span class="meta-item text-dim">{CATEGORY_LABELS[achievement.category]}</span>
					</div>
				</header>

				{
					images.length > 0 && (
						<section class="block mb-7" aria-labelledby="gallery">
							<h2 class="mb-3 flex items-baseline gap-2 text-[0.75rem] font-normal tracking-[0.06em] text-[#26a269] uppercase" id="gallery">
								gallery
								<span class="count text-[0.6875rem] text-[#4a4a4a]">{String(images.length).padStart(2, '0')}</span>
							</h2>
							<AchievementGallery images={images} title={achievement.title} />
						</section>
					)
				}

				<section class="prose" aria-label="Overview">
					{achievement.detail.overview.map((paragraph) => (
						<p class="mb-[1.1rem] max-w-[68ch] text-[#a5a3a9]" set:html={paragraph} />
					))}
				</section>

				{
					highlights.length > 0 && (
						<section class="block mt-7" aria-labelledby="highlights">
							<h2 class="mb-3 flex items-baseline gap-2 text-[0.75rem] font-normal tracking-[0.06em] text-[#26a269] uppercase" id="highlights">highlights</h2>
							<ul class="highlights m-0 list-none p-0">
								{highlights.map((item) => (
									<li class="relative mb-[0.4rem] max-w-[68ch] pl-[1.1rem] text-[#a5a3a9]">{item}</li>
								))}
							</ul>
						</section>
					)
				}

				{
					!metaOnly && achievement.detail.stack && achievement.detail.stack.length > 0 && (
						<section class="block mt-7" aria-labelledby="stack">
							<h2 class="mb-3 flex items-baseline gap-2 text-[0.75rem] font-normal tracking-[0.06em] text-[#26a269] uppercase" id="stack">stack</h2>
							<ul class="stack m-0 flex list-none flex-wrap gap-[0.35rem] p-0">
								{achievement.detail.stack.map((item) => (
									<li class="rounded-[3px] border border-[#3d3846] px-[0.35rem] py-[0.05rem] text-[0.6875rem] text-[#a5a3a9]">{item}</li>
								))}
							</ul>
						</section>
					)
				}

				{
					!metaOnly && (
						<section class="block mt-7" aria-labelledby="tags">
							<h2 class="mb-3 flex items-baseline gap-2 text-[0.75rem] font-normal tracking-[0.06em] text-[#26a269] uppercase" id="tags">tags</h2>
							<ul class="stack m-0 flex list-none flex-wrap gap-[0.35rem] p-0">
								{achievement.tags.map((tag) => (
									<li class="rounded-[3px] border border-[#3d3846] px-[0.35rem] py-[0.05rem] text-[0.6875rem] text-[#a5a3a9]">{tag}</li>
								))}
							</ul>
						</section>
					)
				}

				{metaOnly && (
					<div class="sr-only" aria-hidden="true">
						{keywords.map((keyword) => <span>{keyword}</span>)}
					</div>
				)}

				{
					achievement.links && achievement.links.length > 0 && (
						<section class="block mt-7" aria-labelledby="links">
							<h2 class="mb-3 flex items-baseline gap-2 text-[0.75rem] font-normal tracking-[0.06em] text-[#26a269] uppercase" id="links">links</h2>
							<div class="actions flex flex-wrap gap-2">
								{achievement.links.map((link) => (
									<a class="action inline-flex items-center gap-[0.3rem] rounded-[3px] border border-[#3d3846] px-[0.55rem] py-1 text-[0.75rem] text-[#deddda] no-underline hover:border-[#5a5560] hover:bg-line hover:text-white focus-visible:outline focus-visible:outline-[#26a269] focus-visible:outline-offset-2" href={link.href} target="_blank" rel="noreferrer">
										{link.label}
										<ArrowUpRight size={12} strokeWidth={1.5} aria-hidden="true" />
									</a>
								))}
							</div>
						</section>
					)
				}

				<footer class="foot mt-9 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6 max-[639px]:flex-col max-[639px]:items-start">
					<a class="back inline-flex items-center gap-[0.35rem] text-[0.75rem] text-[#a5a3a9] no-underline hover:text-[#26a269] focus-visible:outline focus-visible:outline-[#26a269] focus-visible:outline-offset-2" href={basePath}>
						<ArrowLeft size={13} strokeWidth={1.5} aria-hidden="true" />
						{backLabel}
					</a>

					{
						showSiblings && (
							<div class="siblings flex flex-wrap gap-2">
								<a class="sibling flex flex-col gap-[0.1rem] rounded-sm border border-[#3d3846] px-[0.6rem] py-[0.35rem] no-underline hover:border-[#5a5560] hover:bg-[#1c1c1c] focus-visible:outline-1 focus-visible:outline-[#26a269] focus-visible:outline-offset-2" href={`${basePath}/${previous.slug}`}>
									<span class="sibling-label text-[0.625rem] tracking-[0.06em] text-dim uppercase">prev</span>
									<span class="sibling-title text-[0.75rem] text-[#deddda]">{previous.title}</span>
								</a>
								<a class="sibling flex flex-col gap-[0.1rem] rounded-sm border border-[#3d3846] px-[0.6rem] py-[0.35rem] no-underline hover:border-[#5a5560] hover:bg-[#1c1c1c] focus-visible:outline focus-visible:outline-[#26a269] focus-visible:outline-offset-2" href={`${basePath}/${next.slug}`}>
									<span class="sibling-label text-[0.625rem] tracking-[0.06em] text-dim uppercase">next</span>
									<span class="sibling-title text-[0.75rem] text-[#deddda]">{next.title}</span>
								</a>
							</div>
						)
					}
				</footer>
			</div>
		</div>
	</main>
</Base>

<style>
	.highlights li {
		position: relative;
	}

	.highlights li::before {
		content: '-';
		position: absolute;
		left: 0;
		color: #26a269;
	}

	/* Inline links inside overview paragraphs, authored as HTML in the data. */
	.prose :global(a) {
		color: #26a269;
		text-decoration: underline;
		text-decoration-color: rgba(38, 162, 105, 0.4);
		text-underline-offset: 2px;
	}

	.prose :global(a:hover) {
		color: #33d17a;
		text-decoration-color: currentColor;
	}

	.prose :global(a:focus-visible) {
		outline: 1px solid #26a269;
		outline-offset: 2px;
		border-radius: 2px;
	}
</style>
